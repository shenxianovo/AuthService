# Copy to .env on the server and fill in real values. Never commit the real .env.

# --- Database ---
DB_PASSWORD=change-me-strong-password

# --- JWT ---
# Defaults to "AuthService" if omitted; RSA keys are NOT here (see secrets/).
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# --- GitHub OAuth ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://auth.shenxianovo.com/api/v1/auth/github/callback

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://auth.shenxianovo.com/api/v1/auth/google/callback

# --- Resend email ---
RESEND_API_KEY=
