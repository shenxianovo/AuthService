{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Issuer": "https://auth.shenxianovo.com",
        "Audience": "https://auth.shenxianovo.com",
        "PrivateKeyPath": "Keys/private.pem",
        "PublicKeyPath": "Keys/public.pem"
    },
    "GithubOAuth": {
        "ClientId": "",
        "ClientSecret": "",
        "CallbackUrl": ""
    },
    "GoogleOAuth": {
        "ClientId": "",
        "ClientSecret": "",
        "CallbackUrl": ""
    },
    "OAuthSecurity": {
        "AllowedRedirectOrigins": [
            "https://*.shenxianovo.com"
        ],
        "AuthCodeExpirationSeconds": 60,
        "StateExpirationSeconds": 600
    },
    "Admin": {
        "BootstrapUsername": ""
    },
    "Oidc": {
        "EncryptionKey": "",
        "Clients": [
            {
                "ClientId": "openlist",
                "ClientSecret": "",
                "DisplayName": "OpenList",
                "RedirectUris": [
                    "https://pan.shenxianovo.com/api/auth/sso_callback",
                    "https://pan.shenxianovo.com/api/auth/sso_callback?method=get_sso_id",
                    "https://pan.shenxianovo.com/api/auth/sso_callback?method=sso_get_token"
                ],
                "Scopes": [ "profile", "email" ]
            }
        ]
    },
    "Resend": {
        "ApiKey": "",
        "FromEmail": "noreply@shenxianovo.com",
        "FromName": "AuthService",
        "VerificationCodeExpirationMinutes": 15,
        "PasswordResetExpirationMinutes": 30,
        "PasswordResetUrlBase": "https://auth.shenxianovo.com/reset-password"
    }
}
